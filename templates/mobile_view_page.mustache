<div class="teamsmeetings-mobile">
    {{#intro}}
    <div class="intro">{{{intro}}}</div>
    {{/intro}}
    <ul class="list-unstyled mt-2">
        <li><strong>{{#str}}starttime, mod_teamsmeetings{{/str}}:</strong> {{starttime}}</li>
        {{#endtime}}
        <li><strong>{{#str}}endtime, mod_teamsmeetings{{/str}}:</strong> {{endtime}}</li>
